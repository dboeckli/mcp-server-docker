{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "github-actions": {
    "enabled": false
  },
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": ">=3.12.0 <3.13.0"
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "groupName": "Python dependencies"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Docker base images"
    },
    {
      "matchManagers": [
        "devbox"
      ],
      "groupName": "devbox packages"
    },
    {
      "matchManagers": [
        "devbox"
      ],
      "matchPackageNames": [
        "nodejs"
      ],
      "allowedVersions": ">=26.0.0 <27.0.0",
      "dependencyDashboardApproval": false,
      "groupName": "Node.js"
    }
  ]
}
