{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.6/.schema/devbox.schema.json",
  "packages": ["nodejs@26.13.0", "uv@0.4.30", "taplo@0.9.3"],
  "shell": {
    "init_hook": ["echo 'Welcome to devbox!' > /dev/null"],
    "scripts": {
      "python-lint": ["uv run ruff check src/**/*.py --format"],
      "prettier-format": [
        "npx --yes prettier@3.9.10 --write --prose-wrap=always *.json *.md"
      ],
      "prettier-check": ["npx --yes prettier@3.9.10 --check *.json *.md"],
      "mcp-run": ["uv run mcp-server-docker"],
      "mcp-inspector": [
        "npx --yes @modelcontextprotocol/inspector@2.14.0 uv run mcp-server-docker"
      ],
      "pyproject-check": [
        "taplo check pyproject.toml --schema https://json.schemastore.org/pyproject.json"
      ],
      "pyproject-format": ["taplo format pyproject.toml"]
    }
  }
}
